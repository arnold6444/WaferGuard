# PostgreSQL is the standard local development path.
STORAGE_BACKEND=postgres
RDS_HOST=127.0.0.1
RDS_PORT=5432
RDS_DB=waferguard
RDS_USER=waferguard
RDS_PASSWORD=waferguard

# Reuse PostgreSQL connections instead of opening one TCP connection per query.
DB_POOL_MIN=1
DB_POOL_MAX=10

# Docker host port. Set to 5433 when another local PostgreSQL owns 5432.
POSTGRES_PORT=5432
POSTGRES_DB=waferguard
POSTGRES_USER=waferguard
POSTGRES_PASSWORD=waferguard

# Local FAB v2 event transport (Mosquitto in compose.yaml).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TRANSPORT=mqtt
MQTT_CONSUMER_CLIENT_ID=waferguard-fab-v2-consumer
MQTT_CONNECT_TIMEOUT_SECONDS=10
FAB_SYNTHETIC_DEBUG=0

# Local object storage remains the default; use s3 explicitly in AWS.
IMAGE_BACKEND=local
